# Signing material — never commit. Losing it means losing the Play listing;
# leaking it means anyone can sign updates as you. Back it up privately.
android/app/*.keystore
android-keystore-backup/

# Capacitor: staged web copy, regenerated by `npm run build:www`
www/

# Play Store screenshots — regenerate with `npm run screenshots`
store-screenshots/

# Capacitor Android project — build output and local machine config only,
# the rest (AndroidManifest.xml, MainActivity, res/, build.gradle) is source.
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/.gradle/
android/local.properties
android/*.apk
android/*.aab
android/*.idsig

# Old Bubblewrap TWA project, superseded by Capacitor — kept locally for reference
android-twa-old/

node_modules/
dl/
